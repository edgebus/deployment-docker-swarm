  # Reverse proxy to Nginx
  [http.services.standalone-nginx.loadBalancer]
    passHostHeader = true
    serversTransport = "standalone-nginx-transport"
    # https://doc.traefik.io/traefik/v2.11/routing/services/#servers
    [[http.services.standalone-nginx.loadBalancer.servers]]
      url = "https://168.119.116.51:8443/"
  [http.routers.standalone-nginx_http]
    rule = "Host(`devgame.xoob.gg`) || Host(`devgame-api.xoob.gg`)"
    service = "standalone-nginx@file"
    entrypoints = ["web"]
    priority = 1
  [http.routers.standalone-nginx_https]
    rule = "Host(`devgame.xoob.gg`) || Host(`devgame-api.xoob.gg`)"
    service = "standalone-nginx@file"
    entrypoints = ["websecure"]
    priority = 1
    [http.routers.standalone-nginx_https.tls]
      certResolver = "defaultCertificatesResolver"
  [http.serversTransports.standalone-nginx-transport]
    insecureSkipVerify = true
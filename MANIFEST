#
# Define a set of swarm networks to be attached to the service
#
#portainer.network.0=portainer
#...
#portainer.network.z=...

#
# Define a set of placement constraints
#
#portainer.placement_constraint.0=example.org
#...
#portainer.placement_constraint.z=...

#
# Name of commit label
#
#portainer.label.commit=example.org.stack.commit

#
# Name of pipeline label
#
#portainer.label.pipeline=example.org.stack.pipeline

#
# Name of version label
#
#portainer.label.version=example.org.stack.version

#
# Name of service
#
portainer.name=portainer

#
# Network alias
#
portainer.alias=portainer

#
# Number of replicas
#
portainer.replicas=1

#
# Limit processes/threads
#
portainer.ulimits.nproc=256

#
# Limit of file descriptors.
# Maximum number of opened files.
#
portainer.ulimits.nofile.hard=16384

#
# Limit of file descriptors.
# May be changed later by an app, up to the hard limit value, by the process running with these limits.
#
portainer.ulimits.nofile.soft=8192

#
# How much of the available CPU resources, as number of cores, a container can use.
# The platform must guarantee the container can allocate at least the configured amount.
#
portainer.resources.reservations.cpus=0.01

#
# How much of the available amount of memory a container can allocate.
# The platform must guarantee the container can allocate at least the configured amount.
#
portainer.resources.reservations.memory=8M

#
# How much of the available CPU resources, as number of cores, a container can use.
# The platform must prevent the container to allocate more.
#
portainer.resources.limits.cpus=1.05

#
# How much of the available amount of memory a container can allocate.
# The platform must prevent the container to allocate more.
#
portainer.resources.limits.memory=64M

#
# Order of operations during updates
# See more https://docs.docker.com/reference/compose-file/deploy/#update_config
# Enum: start-first, stop-first
#
portainer.deploy.update_config.order=start-first

#
# Expose Portainer via load balancer (for example Traefik) 
#
portainer.expose.lb.domain=portainer.example.org
portainer.expose.lb.http.entrypoints=web
portainer.expose.lb.http.middlewares=force-ssl@file
portainer.expose.lb.https.entrypoints=websecure
portainer.expose.lb.https.middlewares=force-ssl@file
portainer.expose.lb.https.certresolver=defaultCertificatesResolver
# To-do remove the following line after the framework supports using $index
portainer.expose.lb.https.domains.0.index=0
portainer.expose.lb.https.domains.0.main=portainer.example.org
portainer.expose.lb.https.domains.0.sans=*.portainer.example.org
# To-do remove the following line after the framework supports using $index
portainer.expose.lb.https.domains.1.index=1
portainer.expose.lb.https.domains.1.main=example.org
portainer.expose.lb.https.domains.1.sans=*.example.org

#
# Expose Portainer via the host machine
#
portainer.expose.publish.host=127.0.0.1
portainer.expose.publish.port=9999

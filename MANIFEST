#
# Define a set of swarm networks to be attached to the service
#
#prometheus.network.0=grafana-prometheus-tier
#...
#network.z=...

#
# Define a set of placement constraints
#
#prometheus.placement_constraint.0=example.org
#...
#placement_constraint.z=...

#
# Name of commit label
#
#prometheus.label.commit=example.org.stack.commit

#
# Name of pipeline label
#
#prometheus.label.pipeline=example.org.stack.pipeline

#
# Name of version label
#
#prometheus.label.version=example.org.stack.version

#
# Name of service
#
prometheus.name=prometheus

#
# Network alias
#
prometheus.alias=prometheus

#
# Number of replicas
#
prometheus.replicas=1

#
# Limit processes/threads
#
prometheus.ulimits.nproc=256

#
# Limit of file descriptors.
# Maximum number of opened files.
#
prometheus.ulimits.nofile.hard=16384

#
# Limit of file descriptors.
# May be changed later by an app, up to the hard limit value, by the process running with these limits.
#
prometheus.ulimits.nofile.soft=8192

#
# How much of the available CPU resources, as number of cores, a container can use.
# The platform must guarantee the container can allocate at least the configured amount.
#
prometheus.resources.reservations.cpus=0.01

#
# How much of the available amount of memory a container can allocate.
# The platform must guarantee the container can allocate at least the configured amount.
#
prometheus.resources.reservations.memory=8M

#
# How much of the available CPU resources, as number of cores, a container can use.
# The platform must prevent the container to allocate more.
#
prometheus.resources.limits.cpus=1.05

#
# How much of the available amount of memory a container can allocate.
# The platform must prevent the container to allocate more.
#
prometheus.resources.limits.memory=64M

#
# Order of operations during updates
# See more https://docs.docker.com/reference/compose-file/deploy/#update_config
# Enum: start-first, stop-first
#
prometheus.deploy.update_config.order=start-first

#
# Expose prometheus via load balancer (for example Traefik) 
#
prometheus.expose.lb.domain=prometheus.example.org
prometheus.expose.lb.http.entrypoints=web
prometheus.expose.lb.http.middlewares=force-ssl@file
prometheus.expose.lb.https.entrypoints=websecure
prometheus.expose.lb.https.middlewares=force-ssl@file
prometheus.expose.lb.https.certresolver=defaultCertificatesResolver
# To-do remove the following line after the framework supports using $index
prometheus.expose.lb.https.domains.0.index=0
prometheus.expose.lb.https.domains.0.main=prometheus.example.org
prometheus.expose.lb.https.domains.0.sans=*.prometheus.example.org
# To-do remove the following line after the framework supports using $index
prometheus.expose.lb.https.domains.1.index=1
prometheus.expose.lb.https.domains.1.main=example.org
prometheus.expose.lb.https.domains.1.sans=*.example.org

#
# Expose prometheus via the host machine
#
prometheus.expose.publish.host=127.0.0.1
prometheus.expose.publish.port=9999

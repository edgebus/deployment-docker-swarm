#
# Define a set of swarm networks to be attached to the service
#
traefik.stack.network.0=traefik-tier
#...
#traefik.stack.network.z=...

#
# Define a set of placement constraints
#
traefik.stack.placement_constraint.0=example.org
#...
#traefik.stack.placement_constraint.z=...

#
# Name of commit label
#
traefik.stack.label.commit=example.org.stack.commit

#
# Name of pipeline label
#
traefik.stack.label.pipeline=example.org.stack.pipeline

#
# Name of version label
#
traefik.stack.label.version=example.org.stack.version

#
# Name of service
#
traefik.stack.name=traefik

#
# Network alias
#
traefik.stack.alias=traefik

#
# Limit processes/threads
#
traefik.stack.ulimits.nproc=256

#
# Limit of file descriptors.
# Maximum number of opened files.
#
traefik.stack.ulimits.nofile.hard=16384

#
# Limit of file descriptors.
# May be changed later by an app, up to the hard limit value, by the process running with these limits.
#
traefik.stack.ulimits.nofile.soft=8192

#
# How much of the available CPU resources, as number of cores, a container can use.
# The platform must guarantee the container can allocate at least the configured amount.
#
traefik.stack.deploy.resources.reservations.cpus=0.01

#
# How much of the available amount of memory a container can allocate.
# The platform must guarantee the container can allocate at least the configured amount.
#
traefik.stack.deploy.resources.reservations.memory=8M

#
# How much of the available CPU resources, as number of cores, a container can use.
# The platform must prevent the container to allocate more.
#
traefik.stack.deploy.resources.limits.cpus=1.05

#
# How much of the available amount of memory a container can allocate.
# The platform must prevent the container to allocate more.
#
traefik.stack.deploy.resources.limits.memory=64M

#
# Choose format "common", "json". See https://doc.traefik.io/traefik/v2.11/observability/access-logs/#format
#
traefik.conf.accesslog.format="common"
traefik.conf.accesslog.fields.default_mode="keep"
traefik.conf.accesslog.fields.names.0="clientUsername"
traefik.conf.accesslog.fields.headers_default_mode="drop"
traefik.conf.accesslog.fields.keep_headers.0="Host"
traefik.conf.accesslog.fields.keep_headers.1="X-Real-IP"
traefik.conf.accesslog.fields.keep_headers.2="Content-Type"

#
# Alternative logging levels are DEBUG, INFO, WARN, ERROR, FATAL, and PANIC.
# See https://doc.traefik.io/traefik/v2.11/observability/logs/#level
#
traefik.conf.log.level="WARN"
#
# Choose logging format "common", "json"
# https://doc.traefik.io/traefik/v2.11/observability/logs/#format
#
traefik.conf.log.format="json"

#
# Port on which to listen for incoming connections and packets
#
traefik.conf.entrypoints.web.port=80
#
# Protocol to use (tcp or udp)
#
traefik.conf.entrypoints.web.protocol=tcp
#
# You can configure Traefik to trust the forwarded headers information
# (X-Forwarded-*) by insecure mode (always trusting forwarded headers).
# See: https://doc.traefik.io/traefik/v2.11/routing/entrypoints/#forwarded-headers
#
#traefik.conf.entrypoints.web.forwarded_headers.kind="insecure"
#
# You can configure Traefik to trust the forwarded headers information
# (X-Forwarded-*) by IP whitelist.
# See: https://doc.traefik.io/traefik/v2.11/routing/entrypoints/#forwarded-headers
#
#traefik.conf.entrypoints.web.forwarded_headers.kind="whitelist"
#traefik.conf.entrypoints.web.forwarded_headers.whitelist.ip.0="127.0.0.1/32"
#traefik.conf.entrypoints.web.forwarded_headers.whitelist.ip.1="192.168.1.7"
#
# Setup timeouts for incoming requests to the Traefik instance.
# Setting them has no effect for UDP entryPoints.
# See: https://doc.traefik.io/traefik/v2.11/routing/entrypoints/#respondingtimeouts
#
traefik.conf.entrypoints.web.timeout.read="900s"
traefik.conf.entrypoints.web.timeout.write="900s"
traefik.conf.entrypoints.web.timeout.idle="300s"


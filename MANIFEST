#
# Define a set of swarm networks to be attached to the service
#
#traefik.network.0=traefik-tier
#...
#network.z=...

#
# Define a set of placement constraints
#
#traefik.placement_constraint.0=example.org
#...
#placement_constraint.z=...

#
# Name of commit label
#
#traefik.label.commit=example.org.stack.commit

#
# Name of pipeline label
#
#traefik.label.pipeline=example.org.stack.pipeline

#
# Name of version label
#
#traefik.label.version=example.org.stack.version

#
# Name of service
#
#traefik.name=traefik

#
# Network alias
#
#traefik.alias=traefik

#
# Number of replicas
#
#traefik.replicas=2

#
# Limit processes/threads
#
#traefik.ulimits.nproc=256

#
# Limit of file descriptors.
# Maximum number of opened files.
#
#traefik.ulimits.nofile.hard=16384

#
# Limit of file descriptors.
# May be changed later by an app, up to the hard limit value, by the process running with these limits.
#
#traefik.ulimits.nofile.soft=8192

#
# How much of the available CPU resources, as number of cores, a container can use.
# The platform must guarantee the container can allocate at least the configured amount.
#
#traefik.resources.reservations.cpus=0.01

#
# How much of the available amount of memory a container can allocate.
# The platform must guarantee the container can allocate at least the configured amount.
#
#traefik.resources.reservations.memory=8M

#
# How much of the available CPU resources, as number of cores, a container can use.
# The platform must prevent the container to allocate more.
#
#traefik.resources.limits.cpus=1.05

#
# How much of the available amount of memory a container can allocate.
# The platform must prevent the container to allocate more.
#
#traefik.resources.limits.memory=64M

#
# Order of operations during updates
# See more https://docs.docker.com/reference/compose-file/deploy/#update_config
# Enum: start-first, stop-first
#
#traefik.deploy.update_config.order=start-first

#
# Port on which to listen for incoming connections and packets
#
#traefik.entryPoints.web.port=80
#
# Protocol to use (tcp or udp)
#
#traefik.entryPoints.web.protocol=tcp

#traefik.entryPoints.websecure.port=433
#traefik.entryPoints.websecure.protocol=tcp

version: "3.9"

configs:
  docker-expand-envs-entrypoint.sh:
    name: {{ traefik.stack.name }}-docker-expand-envs-entrypoint.sh-{{ DEPLOYMENT_JOB_ID }}
{%- if DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS == "true" %}
    external: true
{%- else %}
    file: ./misc/docker-expand-envs-entrypoint.sh
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{ DEPLOYMENT_CLUSTER }}.{{ traefik.stack.name }}=true"
      - "io.edgebus.ops.commit={{ DEPLOYMENT_COMMIT }}"
{%- if traefik.stack.label.commit %}
      - "{{ traefik.stack.label.commit }}={{ DEPLOYMENT_COMMIT }}"
{%- endif %}
{%- if traefik.stack.label.pipeline %}
      - "{{ traefik.stack.label.pipeline }}={{ DEPLOYMENT_PIPELINE_URL }}"
{%- endif %}
{%- if traefik.stack.label.version %}
      - "{{ traefik.stack.label.version }}={{ DEPLOYMENT_VERSION }}"
{%- endif %}
{%- endif %}
  traefik-dynamic.toml:
    name: {{ traefik.stack.name }}-dynamic.toml-{{ DEPLOYMENT_JOB_ID }}
{%- if DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS == "true" %}
    external: true
{%- else %}
    file: ./etc/{{ DEPLOYMENT_CLUSTER }}/traefik-dynamic.toml
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{ DEPLOYMENT_CLUSTER }}.{{ traefik.stack.name }}=true"
      - "io.edgebus.ops.commit={{ DEPLOYMENT_COMMIT }}"
{%- if traefik.label.commit %}
      - "{{ traefik.stack.label.commit }}={{ DEPLOYMENT_COMMIT }}"
{%- endif %}
{%- if traefik.stack.label.pipeline %}
      - "{{ traefik.stack.label.pipeline }}={{ DEPLOYMENT_PIPELINE_URL }}"
{%- endif %}
{%- if traefik.stack.label.version %}
      - "{{ traefik.stack.label.version }}={{ DEPLOYMENT_VERSION }}"
{%- endif %}
{%- endif %}

volumes:
  traefik:
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{ DEPLOYMENT_CLUSTER }}.{{ traefik.stack.name }}=true"
      - "io.edgebus.ops.commit={{ DEPLOYMENT_COMMIT }}"
{%- if traefik.stack.label.commit %}
      - "{{ traefik.stack.label.commit }}={{ DEPLOYMENT_COMMIT }}"
{%- endif %}
{%- if traefik.stack.label.pipeline %}
      - "{{ traefik.stack.label.pipeline }}={{ DEPLOYMENT_PIPELINE_URL }}"
{%- endif %}
{%- if traefik.stack.label.version %}
      - "{{ traefik.stack.label.version }}={{ DEPLOYMENT_VERSION }}"
{%- endif %}

networks:
  internet-access:
    name: bridge
    external: true
{%- for network in traefik.stack.network['$array'] %}
  {{ network }}:
    driver: overlay
    attachable: false
    internal: true
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{ DEPLOYMENT_CLUSTER }}.{{ traefik.stack.name }}=true"
      - "io.edgebus.ops.commit={{ DEPLOYMENT_COMMIT }}"
{%- if traefik.stack.label.commit %}
      - "{{ traefik.stack.label.commit }}={{ DEPLOYMENT_COMMIT }}"
{%- endif %}
{%- if traefik.stack.label.pipeline %}
      - "{{ traefik.stack.label.pipeline }}={{ DEPLOYMENT_PIPELINE_URL }}"
{%- endif %}
{%- if traefik.stack.label.version %}
      - "{{ traefik.stack.label.version }}={{ DEPLOYMENT_VERSION }}"
{%- endif %}
{%- endfor %}

services:
  {{ traefik.stack.name }}:
    image: theanurin/traefik:2.11.18-0
    entrypoint:
      - /usr/local/bin/docker-expand-envs-entrypoint.sh
      - /entrypoint.sh
      - traefik
    ports:
{%- for entrypoints in traefik.conf.entrypoints['$array'] %}
      - published: {{ entrypoints.port }}
        target: {{ entrypoints.port }}
        protocol: {{ entrypoints.protocol }}
        mode: host
{%- endfor %}
    volumes:
      - traefik:/traefik-data
      # So that Traefik can listen to the Docker events
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
{%- if traefik.conf.default_certificate %}
      DEFAULT_CERT_COUNTRY: {{ traefik.conf.default_certificate.country }}
      DEFAULT_CERT_STATE: {{ traefik.conf.default_certificate.state }}
      DEFAULT_CERT_ORGANIZATION: {{ traefik.conf.default_certificate.organization }}
      DEFAULT_CERT_ORGANIZATION_UNIT: {{ traefik.conf.default_certificate.organizationUnit }}
      DEFAULT_CERT_EMAIL_ADDRESS: {{ traefik.conf.default_certificate.emailAddress }}
      DEFAULT_CERT_ROOT_DOMAIN: {{ traefik.conf.default_certificate.root_domain }}
{%- endif %}
      TRAEFIK_ENTRYPOINTS_WEB_ADDRESS: "0.0.0.0:80"
{% comment %}
{%- if traefik.conf.accesslog %}
{%- for accesslog in traefik.conf.accesslog['$array'] %}
      TRAEFIK_ACCESSLOG_FORMAT: {{ accesslog.format }}
      TRAEFIK_ACCESSLOG_FIELDS_DEFAULTMODE: {{ accesslog.defaultMode }}
      TRAEFIK_ACCESSLOG_FIELDS_NAMES: "drop"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_DEFAULTMODE: {{ accesslog.fields.headers_default_mode }}
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES: "keep"
{%- endfor %}
{%- endif %}
{% endcomment %}

{%- if traefik.conf.log %}
      TRAEFIK_LOG_LEVEL: {{ traefik.conf.log.level }}
      TRAEFIK_LOG_FORMAT: {{ traefik.conf.log.format }}
{%- endif %}

{%- if traefik.conf.providers.file %}
      TRAEFIK_PROVIDERS_FILE_FILENAME: {{traefik.conf.providers.file.filename}}
      TRAEFIK_PROVIDERS_FILE_WATCH: {{traefik.conf.providers.file.watch}}
{%- endif%}

{%- if traefik.conf.providers.docker %}
      TRAEFIK_PROVIDERS_DOCKER_ENDPOINT: {{ traefik.conf.providers.docker.endpoint }}
      TRAEFIK_PROVIDERS_DOCKER_EXPOSEDBYDEFAULT: {{ traefik.conf.providers.docker.exposedbydefault }}
      TRAEFIK_PROVIDERS_DOCKER_CONSTRAINTS: {{ traefik.conf.providers.docker.constraints }}
      TRAEFIK_PROVIDERS_DOCKER_DEFAULTRULE: {{ traefik.conf.providers.docker.defaultrule }}
      TRAEFIK_PROVIDERS_DOCKER_SWARMMODE: {{ traefik.conf.providers.docker.swarmmode }}
      TRAEFIK_PROVIDERS_DOCKER_SWARMMODEREFRESHSECONDS: {{ traefik.conf.providers.docker.swarmmoderefreshseconds }}
{%- endif%}

{%- if traefik.conf.api %}
      TRAEFIK_API_INSECURE: {{ traefik.conf.api.insecure }}
      TRAEFIK_DASHBOARD: {{ traefik.conf.api.dashboard }}
{%- endif%}

{%- if traefik.conf.entrypoints.web %}
{%- for forwarded_headers in traefik.conf.entrypoints.web.forwarded_headers['$array'] %}
      TRAEFIK_ENTRYPOINTS_WEB_FORWARDEDHEADERS_INSECURE: {{ traefik.conf.entrypoints.web.forwarded_headers.kind }}
{%- endfor %}
{%- if traefik.conf.entrypoints.web.timeout %}
      TRAEFIK_ENTRYPOINTS_WEB_TRANSPORT_RESPONDINGTIMEOUTS_READTIMEOUT: {{ traefik.conf.entrypoints.web.timeout.read }}
      TRAEFIK_ENTRYPOINTS_WEB_TRANSPORT_RESPONDINGTIMEOUTS_WRITETIMEOUT: {{ traefik.conf.entrypoints.web.timeout.write }}
      TRAEFIK_ENTRYPOINTS_WEB_TRANSPORT_RESPONDINGTIMEOUTS_IDLETIMEOUT: {{ traefik.conf.entrypoints.web.timeout.idle }}
{%- endif %}
{%- endif %}

{%- if traefik.conf.entrypoints.websecure %}
      TRAEFIK_ENTRYPOINTS_WEBSECURE_ADDRESS: "0.0.0.0:{{traefik.conf.entrypoints.websecure.port}}"
      TRAEFIK_ENTRYPOINTS_WEBSECURE_FORWARDEDHEADERS_INSECURE: {{traefik.conf.entrypoints.websecure.forwarded_headers.kind}}
{%- endif %}
{%- if traefik.conf.entrypoints.metrics %}
      TRAEFIK_ENTRYPOINTS_METRICS_ADDRESS: "0.0.0.0:{{traefik.conf.entrypoints.metrics.port}}"
      TRAEFIK_ENTRYPOINTS_METRICS_TRANSPORT_RESPONDINGTIMEOUTS_READTIMEOUT: {{traefik.conf.entrypoints.metrics.timeout.read}}
      TRAEFIK_ENTRYPOINTS_METRICS_TRANSPORT_RESPONDINGTIMEOUTS_WRITETIMEOUT: {{traefik.conf.entrypoints.metrics.timeout.write}}
      TRAEFIK_ENTRYPOINTS_METRICS_TRANSPORT_RESPONDINGTIMEOUTS_IDLETIMEOUT: {{traefik.conf.entrypoints.metrics.timeout.idle}}
      TRAEFIK_METRICS_PROMETHEUS_ENTRYPOINT: {{traefik.conf.metrics.prometheus.entrypoint}}
{%- endif %}
    configs:
      - source: docker-expand-envs-entrypoint.sh
        target: /usr/local/bin/docker-expand-envs-entrypoint.sh
        mode: 0755
      - source: traefik-dynamic.toml
        target: /etc/traefik/traefik-dynamic.toml
        mode: 0644
    networks:
      internet-access: # Access to external Redis instance
{%- for network in traefik.stack.network['$array'] %}
            {{ network }}:
                  aliases:
                  - {{traefik.stack.alias}}
{%- endfor %}
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{ DEPLOYMENT_CLUSTER }}.{{ traefik.stack.name }}=true"
      - "io.edgebus.ops.commit={{ DEPLOYMENT_COMMIT }}"
{%- if traefik.stack.label.commit %}
      - "{{ traefik.stack.label.commit }}={{ DEPLOYMENT_COMMIT }}"
{%- endif %}
{%- if traefik.stack.label.pipeline %}
      - "{{ traefik.stack.label.pipeline }}={{ DEPLOYMENT_PIPELINE_URL }}"
{%- endif %}
{%- if traefik.stack.label.version %}
      - "{{ traefik.stack.label.version }}={{ DEPLOYMENT_VERSION }}"
{%- endif %}
    logging:
      driver: local
      options:
        compress: "false"
        max-size: "50m"
        max-file: 5
{%- if traefik.stack.ulimits %}
    ulimits: # overrides the default ulimits for a container.
      nproc: {{ traefik.stack.ulimits.nproc }} # processes/threads
      nofile: # file descriptors
        soft: {{ traefik.stack.ulimits.nofile.hard }} # may be changed later, up to the hard limit value, by the process running with these limits
        hard: {{ traefik.stack.ulimits.nofile.soft }} # maximum number of opened files
{%- endif %}
    deploy:
      mode: global # use 'global' due to Stateful service
      resources: # configures physical resource constraints for container to run on platform.
{%- if traefik.stack.deploy.resources %}
{%- if traefik.stack.deploy.resources.limits %}
        limits:          # The platform must prevent the container to allocate more.
          cpus: "{{ traefik.stack.deploy.resources.limits.cpus }}" # how much of the available CPU resources, as number of cores, a container can use.
          memory: "{{ traefik.stack.deploy.resources.limits.memory }}" # amount of memory a container can allocate
{%- endif %}
{%- if traefik.stack.deploy.resources.reservations %}
        reservations:    # The platform must guarantee the container can allocate at least the configured amount.
          cpus: "{{ traefik.stack.deploy.resources.reservations.cpus }}" # how much of the available CPU resources, as number of cores, a container can use.
          memory: "{{ traefik.stack.deploy.resources.reservations.memory }}" # amount of memory a container can allocate
{%- endif %}
{%- endif %}
      placement:
        constraints:
          - node.labels.io.edgebus.ops==true
{%- for placement_constraint in traefik.stack.placement_constraint['$array'] %}
          - node.labels.{{ placement_constraint }}==true
{%- endfor %}
      # How the service should be updated
      update_config:
        # The number of containers to update at a time.
        parallelism: 1
        # Order of operations during updates. We cannot use 'start-first' due to host ports 80 and 443 are busy
        order: stop-first
        # What to do if an update fails
        failure_action: pause
        # The time to wait between updating a group of containers
        delay: 10s
        # Duration after each task update to monitor for failure
        monitor: 5s
      # If and how to restart containers when they exit.
      restart_policy:
        # containers are restarted regardless of the exit status
        condition: any
        # How long to wait between restart attempts
        delay: 30s
        # How many times to attempt to restart a container before giving up
        max_attempts: 2
        # How long to wait before deciding if a restart has succeeded
        window: 120s

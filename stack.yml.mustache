{{#prometheus}}
version: "3.9"

configs:
  prometheus.yml:
    name: {{name}}.yml-{{$root.DEPLOYMENT_JOB_ID}}
{{#$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
    external: true
{{/$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
{{^$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
    file: ./etc/{{$root.DEPLOYMENT_CLUSTER}}/prometheus.yml
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"
{{/$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
  prometheus-alert-rules-common.yml:
    name: {{name}}-alert-rules-common.yml-{{$root.DEPLOYMENT_JOB_ID}}
{{#$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
    external: true
{{/$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
{{^$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
    file: ./etc/common/prometheus-alert-rules.yml
{{/$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}

volumes:
  prometheus:
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"

networks:
  internet-access:
    name: bridge
    external: true
{{#network.$array}}
  {{ . }}:
    driver: overlay
    attachable: false
    internal: true
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"
{{/network.$array}}

services:
  {{name}}:
    image: prom/prometheus:v3.2.1
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.console.libraries=/usr/share/prometheus/console_libraries
      - --web.console.templates=/usr/share/prometheus/consoles
      # Set url to Web UI
      - --web.external-url=https://prometheus.devel.xoob.gg/
    volumes:
      - prometheus:/prometheus
      # Allow Prometheus to use Docker API to get nodes
      - /var/run/docker.sock:/var/run/docker.sock:ro
    user: nobody:48 # 48 - is an gid of "docker" group
    configs:
      - source: prometheus.yml
        target: /etc/prometheus/prometheus.yml
      - source: prometheus-alert-rules-common.yml
        target: /etc/prometheus/prometheus-alert-rules-common.yml
    networks:
      internet-access: # Access to external Redis instance
{{#network.$array}}
      {{ . }}:
        aliases:
          - {{alias}}
{{/network.$array}}
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"
    logging:
      driver: local
      options:
        compress: "false"
        max-size: "50m"
        max-file: 5
{{#ulimits}}
    ulimits: # overrides the default ulimits for a container.
      nproc: {{nproc}} # processes/threads
      {{#nofile}}
      nofile: # file descriptors
        soft: {{soft}} # may be changed later, up to the hard limit value, by the process running with these limits
        hard: {{hard}} # maximum number of opened files
      {{/nofile}}
{{/ulimits}}
    deploy:
      mode: "global"
      resources: # configures physical resource constraints for container to run on platform.
{{#resources}}
{{#limits}}
        limits:          # The platform must prevent the container to allocate more.
          cpus: "{{cpus}}" # how much of the available CPU resources, as number of cores, a container can use.
          memory: "{{memory}}" # amount of memory a container can allocate
{{/limits}}
{{#reservations}}
        reservations:    # The platform must guarantee the container can allocate at least the configured amount.
          cpus: "{{cpus}}" # how much of the available CPU resources, as number of cores, a container can use.
          memory: "{{memory}}" # amount of memory a container can allocate
{{/reservations}}
{{/resources}}
      placement:
        constraints:
          - node.labels.io.edgebus.ops==true
{{#placement_constraint.$array}}
          - node.labels.{{ . }}==true
      labels:
        - "traefik.enable=true"
        - "traefik.scope=apps"
        - "traefik.docker.network=cluster_loadbalancer-prometheus-tier"

        - "traefik.http.services.cluster_prometheus.loadbalancer.server.port=9090"

{{#expose.?lb}}
{{#?http}}
        # HTTP
        - "traefik.http.routers.cluster_prometheus-http.rule=Host(`{{domain}}`)"
        - "traefik.http.routers.cluster_prometheus-http.service=cluster_prometheus"
        - "traefik.http.routers.cluster_prometheus-http.entrypoints={{entrypoints}}"
        - "traefik.http.routers.cluster_prometheus-http.middlewares={{middlewares}}"
{{/?http}}
{{#?https}}
        # HTTPS
        - "traefik.http.routers.cluster_prometheus-https.rule=Host(`{{domain}}`)"
        - "traefik.http.routers.cluster_prometheus-https.service=cluster_prometheus"
        - "traefik.http.routers.cluster_prometheus-https.entrypoints={{entrypoints}}"
        - "traefik.http.routers.cluster_prometheus-https.middlewares={{middlewares}}"
        - "traefik.http.routers.cluster_prometheus-https.tls=true"
        - "traefik.http.routers.cluster_prometheus-https.tls.certresolver={{certresolver}}"
{{#domains.$array}}
        - "traefik.http.routers.cluster_prometheus-https.tls.domains[{{index}}].main={{main}}"
        - "traefik.http.routers.cluster_prometheus-https.tls.domains[{{index}}].sans={{sans}}"
{{/domains.$array}}
{{/?https}}
{{/expose.?lb}}
{{/placement_constraint.$array}}
{{/prometheus}}

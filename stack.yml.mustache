{{#traefik}}
version: "3.9"

configs:
  docker-expand-envs-entrypoint.sh:
    name: {{name}}.sh-{{$root.DEPLOYMENT_JOB_ID}}
{{#$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
    external: true
{{/$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
{{^$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
    file: ./misc/docker-expand-envs-entrypoint.sh
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"
{{/$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
  traefik-dynamic.toml:
    name: {{name}}-dynamic.toml-{{$root.DEPLOYMENT_JOB_ID}}
{{#$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
    external: true
{{/$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
{{^$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}
    file: ./etc/{{$root.DEPLOYMENT_CLUSTER}}/traefik-dynamic.toml
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"
{{/$root.DEPLOYMENT_EXTERNAL_CONFIGS_AND_SECRETS}}

volumes:
  traefik:
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"

networks:
  internet-access:
    name: bridge
    external: true
{{#network.$array}}
  {{ . }}:
    driver: overlay
    attachable: false
    internal: true
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"
{{/network.$array}}

services:
  {{name}}:
    image: theanurin/traefik:2.11.18-0
    entrypoint:
      - /usr/local/bin/docker-expand-envs-entrypoint.sh
      - /entrypoint.sh
      - traefik
    ports:
{{#entryPoints.$array}}
      - published: {{port}}
        target: {{port}}
        protocol: {{protocol}}
        mode: host
{{/entryPoints.$array}}
    volumes:
      - traefik:/traefik-data
      # So that Traefik can listen to the Docker events
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
{{#certificateAuthority}}
{{#name}}
      DEFAULT_CERT_COMMON_NAME: {{common}}
{{/name}}
      DEFAULT_CERT_COUNTRY: {{country}}
      DEFAULT_CERT_STATE: {{state}}
      DEFAULT_CERT_ORGANIZATION: {{organization}}
      DEFAULT_CERT_ORGANIZATION_UNIT: {{organizationUnit}}
      DEFAULT_CERT_EMAIL_ADDRESS: {{emailAddress}}
      DEFAULT_CERT_ROOT_DOMAIN: {{rootDomain}}
{{/certificateAuthority}}
      TRAEFIK_ACCESSLOG_FORMAT: "json"
      TRAEFIK_ACCESSLOG_FIELDS_DEFAULTMODE: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_NAMES_CLIENTUSERNAME: "drop"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_DEFAULTMODE: "drop"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_HOST: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_X_FORWARDED_FOR: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_X_REAL_IP: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_X_FORWARDED_PROTO: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_USER_AGENT: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_REFERER: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_CONTENT_TYPE: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_ACCEPT: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_ACCEPT_LANGUAGE: "keep"
      TRAEFIK_ACCESSLOG_FIELDS_HEADERS_NAMES_ACCEPT_ENCODING: "keep"

      TRAEFIK_LOG_LEVEL: "WARN"      
      TRAEFIK_LOG_FORMAT: "json"

      TRAEFIK_PROVIDERS_FILE_FILENAME: "/etc/traefik/traefik-dynamic.toml"
      TRAEFIK_PROVIDERS_FILE_WATCH: "false"

      TRAEFIK_PROVIDERS_DOCKER_ENDPOINT: "unix:///var/run/docker.sock"
      TRAEFIK_PROVIDERS_DOCKER_EXPOSEDBYDEFAULT: "false"
      TRAEFIK_PROVIDERS_DOCKER_CONTRAINS: "Label(`traefik.scope`, `apps`)"
      TRAEFIK_PROVIDERS_DOCKER_DEFAULTRULE: "Host(`.devel.xoob.gg`)"
      TRAEFIK_PROVIDERS_DOCKER_SWARMNODE: "true"
      TRAEFIK_PROVIDERS_DOCKER_SWARMNODEREFRESHSECONDS: "5s"

      TRAEFIK_API_INSECURE: "false"
      TRAEFIK_DASHBOARD: "true"

      TRAEFIK_ENTRYPOINTS_WEB_ADDRESS: "0.0.0.0:80"
      TRAEFIK_ENTRYPOINTS_WEB_FORWARDEDHEADERS_INSECURE: "true"
      TRAEFIK_ENTRYPOINTS_WEB_TRANSPORT_RESPONDINGTIMEOUTS_READTIMEOUT: "900s"
      TRAEFIK_ENTRYPOINTS_WEB_TRANSPORT_RESPONDINGTIMEOUTS_WRITETIMEOUT: "900s"
      TRAEFIK_ENTRYPOINTS_WEB_TRANSPORT_RESPONDINGTIMEOUTS_IDLETIMEOUT: "300s"
      TRAEFIK_ENTRYPOINTS_WEBSECURE_ADDRESS: "0.0.0.0:443"
      TRAEFIK_ENTRYPOINTS_WEBSECURE_FORWARDEDHEADERS_INSECURE: "true"
      
      TRAEFIK_ENTRYPOINTS_METRICS_ADDRESS: "0.0.0.0:9323"
      TRAEFIK_ENTRYPOINTS_METRICS_TRANSPORT_RESPONDINGTIMEOUTS_READTIMEOUT: "60s"
      TRAEFIK_ENTRYPOINTS_METRICS_TRANSPORT_RESPONDINGTIMEOUTS_WRITETIMEOUT: "60s"
      TRAEFIK_ENTRYPOINTS_METRICS_TRANSPORT_RESPONDINGTIMEOUTS_IDLETIMEOUT: "180s"

      TRAEFIK_METRICS_PROMETHEUS_ENTRYPOINT: "metrics"

    configs:
      - source: docker-expand-envs-entrypoint.sh
        target: /usr/local/bin/docker-expand-envs-entrypoint.sh
        mode: 0755
      - source: traefik-dynamic.toml
        target: /etc/traefik/traefik-dynamic.toml
        mode: 0644
    networks:
      internet-access: # Access to external Redis instance
{{#network.$array}}
      {{ . }}:
        aliases:
          - {{alias}}
{{/network.$array}}
    labels:
      - "io.edgebus.ops=true"
      - "io.edgebus.ops.atom.{{$root.DEPLOYMENT_CLUSTER}}.{{name}}=true"
      - "io.edgebus.ops.commit={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.commit}}={{$root.DEPLOYMENT_COMMIT}}"
      - "{{label.pipeline}}={{$root.DEPLOYMENT_PIPELINE_URL}}"
      - "{{label.version}}={{$root.DEPLOYMENT_VERSION}}"
    logging:
      driver: local
      options:
        compress: "false"
        max-size: "50m"
        max-file: 5
{{#ulimits}}
    ulimits: # overrides the default ulimits for a container.
      nproc: {{nproc}} # processes/threads
      {{#nofile}}
      nofile: # file descriptors
        soft: {{soft}} # may be changed later, up to the hard limit value, by the process running with these limits
        hard: {{hard}} # maximum number of opened files
      {{/nofile}}
{{/ulimits}}
    deploy:
      mode: global # use 'global' due to Stateful service
      resources: # configures physical resource constraints for container to run on platform.
{{#resources}}
{{#limits}}
        limits:          # The platform must prevent the container to allocate more.
          cpus: "{{cpus}}" # how much of the available CPU resources, as number of cores, a container can use.
          memory: "{{memory}}" # amount of memory a container can allocate
{{/limits}}
{{#reservations}}
        reservations:    # The platform must guarantee the container can allocate at least the configured amount.
          cpus: "{{cpus}}" # how much of the available CPU resources, as number of cores, a container can use.
          memory: "{{memory}}" # amount of memory a container can allocate
{{/reservations}}
{{/resources}}
      placement:
        constraints:
          - node.labels.io.edgebus.ops==true
{{#placement_constraint.$array}}
          - node.labels.{{ . }}==true
{{/placement_constraint.$array}}
      # How the service should be updated
      update_config:
        # The number of containers to update at a time.
        parallelism: 1
        # Order of operations during updates. We cannot use 'start-first' due to host ports 80 and 443 are busy
        order: stop-first
        # What to do if an update fails
        failure_action: pause
        # The time to wait between updating a group of containers
        delay: 10s
        # Duration after each task update to monitor for failure
        monitor: 5s
      # If and how to restart containers when they exit.
      restart_policy:
        # containers are restarted regardless of the exit status
        condition: any
        # How long to wait between restart attempts
        delay: 30s
        # How many times to attempt to restart a container before giving up
        max_attempts: 2
        # How long to wait before deciding if a restart has succeeded
        window: 120s
{{/traefik}}
# my global config
global:
  # Set the scrape interval. Default is every 1 minute.
  scrape_interval: 5m
  # How long until a scrape request times out. Default 1 minute.
  scrape_timeout: 3m
  # Evaluate rules every interval. The default is every 1 minute.
  #evaluation_interval: 15s

# Alertmanager configuration
alerting:
  alertmanagers:
  - scheme: http
    static_configs:
    - targets:
      - alertmanager:9093

# Load rules once and periodically evaluate them according to the global 'evaluation_interval'.
rule_files:
  - prometheus-alert-rules-common.yml
  # - "first_rules.yml"
  # - "second_rules.yml"

# A scrape configuration containing exactly one endpoint to scrape:
# Here it's Prometheus itself.
scrape_configs:
  #
  # Make Prometheus scrape itself for metrics.
  #
  - job_name: "Prometheus"
    static_configs: # https://prometheus.io/docs/prometheus/3.2/configuration/configuration/#static_config
    - targets:
      - "127.0.0.1:9090"
  #
  # Scrape Node Exporter metrics on each Docker Swarm Node
  # see: https://prometheus.io/docs/guides/dockerswarm/
  #
  - job_name: "Docker Swarm Node"
    metrics_path: "/metrics"
    scheme: "http"
    dockerswarm_sd_configs:
      - host: "unix:///var/run/docker.sock"
        role: "nodes"
        port: 9100
    relabel_configs:
      #
      # Set hostname as instance label
      #
      - source_labels: ["__meta_dockerswarm_node_hostname"]
        target_label: "instance"
  #
  # Scrape cAdvisor metrics
  #
  - job_name: "cAdvisor"
    metrics_path: "/metrics"
    scheme: "http"
    #
    # Docker Swarm service discovery configuration
    #
    dockerswarm_sd_configs: # https://prometheus.io/docs/prometheus/3.2/configuration/configuration/#dockerswarm_sd_config
      - host: "unix:///var/run/docker.sock"
        role: "tasks"
        #
        # Scrape port. cAdvisors are listen connection here.
        #
        port: 9323
    relabel_configs: # https://prometheus.io/docs/prometheus/3.2/configuration/configuration/#scrape_config
      #
      # Only keep containers that should be running
      #
      - source_labels: ["__meta_dockerswarm_task_desired_state"]
        regex: "running"
        action: "keep"
      #
      # Only keep containers that is running
      #
      - source_labels: ["__meta_dockerswarm_task_state"]
        regex: "running"
        action: "keep"
      #
      # Only keep containers that have a `cluster_cadvisor` name
      #
      - source_labels: ["__meta_dockerswarm_service_name"]
        regex: "cluster_cadvisor"
        action: "keep"
  #
  # Scrape Docker Swarm services metrics
  # see: https://prometheus.io/docs/guides/dockerswarm/
  #
  - job_name: "Docker Swarm Service"
    #
    # Default scrape path
    # May be overridden by `io.edgebus.ops.prometheus.scrape.path` Docker Swarm label
    #
    metrics_path: "/metrics"
    #
    # Default scrape scheme
    # May be overridden by `io.edgebus.ops.prometheus.scrape.scheme` Docker Swarm label
    #
    scheme: "http"
    #
    # Docker Swarm service discovery configuration
    #
    dockerswarm_sd_configs: # https://prometheus.io/docs/prometheus/3.2/configuration/configuration/#dockerswarm_sd_config
      - host: "unix:///var/run/docker.sock"
        role: "tasks"
        #
        # Default scrape port
        # May be overridden by `io.edgebus.ops.prometheus.scrape.port` Docker Swarm label
        #
        port: 9323
    relabel_configs: # https://prometheus.io/docs/prometheus/3.2/configuration/configuration/#scrape_config
      #
      # Only keep containers that should be running
      #
      - source_labels: ["__meta_dockerswarm_task_desired_state"]
        regex: "running"
        action: "keep"
      #
      # Only keep containers that is running
      #
      - source_labels: ["__meta_dockerswarm_task_state"]
        regex: "running"
        action: "keep"
      #
      # Only keep containers that have a `io.edgebus.ops.prometheus.scrape.enabled=true` label
      #
      - source_labels: ["__meta_dockerswarm_container_label_io_edgebus_ops_prometheus_scrape_enabled"]
        regex: "true"
        action: "keep"
      #
      # Use port (if exists) provided by `io.edgebus.ops.prometheus.scrape.port` Docker Swarm label
      #
      - source_labels: ["__meta_dockerswarm_container_label_io_edgebus_ops_prometheus_scrape_port", "__address__"]
        # IPv4 regex https://stackoverflow.com/a/25969006/2011679
        #   ^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$
        regex: "(\\d+);((((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))):(\\d+)"
        action: "replace"
        separator: ";"
        target_label: "__address__"
        replacement: "$2:$1"
      #
      # Use network provided by `io.edgebus.ops.prometheus.scrape.network` Docker Swarm label
      #
      - source_labels: ["__meta_dockerswarm_container_label_io_edgebus_ops_prometheus_scrape_network"]
        action: "keepequal" # keepequal action requires only 'source_labels' and `target_label`, and no other fields
        target_label: "__meta_dockerswarm_network_name"
      #
      # Use http/https scheme (if exists) provided by `io.edgebus.ops.prometheus.scrape.scheme` Docker Swarm label
      #
      - source_labels: ["__meta_dockerswarm_container_label_io_edgebus_ops_prometheus_scrape_scheme"]
        regex: "(https?)"
        action: "replace"
        target_label: "__scheme__"
      #
      # Format instance label: <service_name>.<task_slot>
      #
      - source_labels: ["__meta_dockerswarm_service_name", "__meta_dockerswarm_task_slot"]
        regex: "(.*)"
        separator: "."
        action: "replace"
        target_label: "instance"
      #
      # Use the stack name as job name
      #
      - source_labels: ["__meta_dockerswarm_service_label_com_docker_stack_namespace"]
        regex: "(.*)"
        action: "replace"
        target_label: "job"
      #
      # Use (if exists) `io.edgebus.ops.prometheus.scrape.job` Docker Swarm label as job name
      #
      - source_labels: ["__meta_dockerswarm_container_label_io_edgebus_ops_prometheus_scrape_job"]
        regex: "(.+)"
        action: "replace"
        target_label: "job"
